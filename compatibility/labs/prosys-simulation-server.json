{
  "$comment": "External Prosys OPC UA Simulation Server 2026.2.2 (build 39) lab. Use an isolated loopback simulator with its built-in Simulation and ComplianceNodes fixtures and anonymous access. Trust the disposable application certificate supplied by PROSYS_CLIENT_CERT in Prosys and keep client-certificate validation enabled. The default None channel exercises ordinary access and synthetic writes; Basic256Sha256 covers secured connections. The write scenarios modify only the synthetic StaticVariables Double and Int32 fixtures.",
  "schemaVersion": 1,
  "server": {
    "id": "prosys-simulation-server",
    "name": "Prosys OPC UA Simulation Server",
    "implementation": "Prosys OPC UA SDK for Java",
    "language": "Java",
    "independent": true,
    "source": "https://prosysopc.com/products/opc-ua-simulation-server/"
  },
  "endpoint": {
    "env": "PROSYS_SIMULATION_ENDPOINT"
  },
  "security": {
    "policy": "Basic256Sha256",
    "modes": [
      "None",
      "Sign",
      "SignAndEncrypt"
    ],
    "default": {
      "policy": "None",
      "mode": "None"
    },
    "clientTrust": "enforced",
    "clientCertificate": {
      "cert": {
        "env": "PROSYS_CLIENT_CERT"
      },
      "key": {
        "env": "PROSYS_CLIENT_KEY"
      }
    }
  },
  "identities": {
    "anonymous": true
  },
  "namespaces": {
    "simulation": "http://www.prosysopc.com/OPCUA/SimulationNodes/",
