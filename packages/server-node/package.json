{
  "name": "opcua-mcp-server",
  "version": "0.3.0",
  "description": "MCP server for OPC UA: read, write, browse, call methods, history, events and alarms.",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "opcua-mcp-server": "./build/index.js",
    "opcua-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/prepare-build.mjs",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "build:sea": "node scripts/build-sea.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opcua",
    "opc-ua",
    "industrial",
    "automation",
    "scada",
    "industrial-automation",
    "iiot",
    "plc"
  ],
  "author": "Midhun Xavier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midhunxavier/OPCUA-MCP.git",
    "directory": "packages/server-node"
  },
  "homepage": "https://github.com/midhunxavier/OPCUA-MCP#readme",
  "bugs": {
    "url": "https://github.com/midhunxavier/OPCUA-MCP/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "node-opcua-client": "^2.183.1",
    "node-opcua-crypto": "^5.10.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "build/**/*",
    "README.md"
  ],
  "mcpName": "io.github.midhunxavier/opcua"
}
