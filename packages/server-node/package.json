{
  "name": "opcua-mcp-server",
  "version": "0.3.0",
  "description": "MCP server for OPC UA control - Model Context Protocol server for OPC UA operations",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "opcua-mcp-server": "./build/index.js",
    "opcua-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/prepare-build.mjs",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "build:sea": "node scripts/build-sea.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opcua",
    "opc-ua",
    "industrial",
    "automation",
    "scada"
  ],
  "author": "Midhun Xavier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midhunxavier/OPCUA-MCP.git",
    "directory": "packages/server-node"
  },
  "homepage": "https://github.com/midhunxavier/OPCUA-MCP#readme",
  "bugs": {
    "url": "https://github.com/midhunxavier/OPCUA-MCP/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "node-opcua": "^2.128.0",
    "node-opcua-client": "^2.128.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "build/**/*",
    "README.md"
  ]
}
