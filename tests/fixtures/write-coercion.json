{
  "$comment": "What a JSON value becomes when it is written to a node of each OPC UA type — the conversion that decides what reaches the plant. Driven by BOTH tests/unit/test_variant_codec.py and packages/server-node/test/variant-codec.test.mjs: each converts `value` for `type` (as an array when `array` is true) and must produce `expected`, or refuse with exactly `error`. #157 found the runtimes' native conversions deciding instead: Node wrote \"\" and [] to a Double as 0 and \"0x10\" as 16, Python wrote true as 1.0 and \"1_000\" as 1000, and a String node received \"true\" from one runtime and \"True\" from the other. `expected` is written in one runtime-neutral form: 64-bit integers as decimal strings, DateTime as ISO-8601 UTC at millisecond precision, Guid lower-case, ByteString as base64, LocalizedText and QualifiedName as their text. A numeric string follows JSON's number grammar — see `numbers`, which the operator policy's bounds read with too (value-bounds.json).",
  "cases": [
    { "type": "Double", "value": 51.75, "expected": 51.75 },
    { "type": "Double", "value": 5, "expected": 5 },
    { "type": "Double", "value": "42.5", "expected": 42.5 },
    { "type": "Double", "value": " 42.5\n", "expected": 42.5, "note": "JSON whitespace around the number is allowed." },
    { "type": "Double", "value": "-0.5", "expected": -0.5 },
    { "type": "Double", "value": "1e3", "expected": 1000 },
    { "type": "Double", "value": "1E-3", "expected": 0.001 },
    { "type": "Double", "value": true, "error": "Cannot convert true to Double", "note": "Python's float() made this 1.0. true is not 1." },
    { "type": "Double", "value": "", "error": "Cannot convert \"\" to Double", "note": "Node's Number() made this 0." },
    { "type": "Double", "value": "   ", "error": "Cannot convert \"   \" to Double" },
    { "type": "Double", "value": "0x10", "error": "Cannot convert \"0x10\" to Double", "note": "Node's Number() made this 16." },
    { "type": "Double", "value": "1_000", "error": "Cannot convert \"1_000\" to Double", "note": "Python's float() made this 1000." },
    { "type": "Double", "value": "+5", "error": "Cannot convert \"+5\" to Double" },
    { "type": "Double", "value": ".5", "error": "Cannot convert \".5\" to Double" },
    { "type": "Double", "value": "5.", "error": "Cannot convert \"5.\" to Double" },
    { "type": "Double", "value": "Infinity", "error": "Cannot convert \"Infinity\" to Double" },
    { "type": "Double", "value": "inf", "error": "Cannot convert \"inf\" to Double" },
    { "type": "Double", "value": "nan", "error": "Cannot convert \"nan\" to Double" },
    { "type": "Double", "value": "١٢", "error": "Cannot convert \"١٢\" to Double", "note": "Arabic-Indic digits, which Python's float() reads as 12." },
    { "type": "Double", "value": "12\u00a0", "error": "Cannot convert \"12\u00a0\" to Double", "note": "A no-break space is not JSON whitespace, though both trim() and strip() remove it." },
    { "type": "Double", "value": "1e400", "error": "1e400 is outside the Double range" },
    { "type": "Double", "value": 1e400, "error": "The number is outside the Double range", "note": "A JSON literal too large for a double: Infinity in JavaScript, inf in Python." },
    { "type": "Double", "value": [5], "error": "Cannot convert [5] to Double", "note": "Node's String([5]) is \"5\", so this was written as 5." },
    { "type": "Double", "value": [], "error": "Cannot convert [] to Double", "note": "Node's Number(String([])) is 0." },
    { "type": "Double", "value": { "v": 1 }, "error": "Cannot convert {\"v\":1} to Double" },
    { "type": "Double", "value": null, "error": "Cannot write null as Double" },

    { "type": "Float", "value": 3.5, "expected": 3.5 },
    { "type": "Float", "value": 3.4028234663852886e38, "expected": 3.4028234663852886e38, "note": "The largest finite single." },
    { "type": "Float", "value": 1e39, "error": "1e+39 is outside the Float range", "note": "node-opcua wrote this as Infinity; python-opcua raised mid-encode." },
    { "type": "Float", "value": "-3.5e38", "error": "-3.5e+38 is outside the Float range" },

    { "type": "Int32", "value": 42, "expected": 42 },
    { "type": "Int32", "value": -2147483648, "expected": -2147483648 },
    { "type": "Int32", "value": "42", "expected": 42 },
    { "type": "Int32", "value": " 42 ", "expected": 42 },
    { "type": "Int32", "value": 5.0, "expected": 5, "note": "JSON cannot tell 5.0 from 5, and JavaScript never sees the difference; Python refused this one." },
    { "type": "Int32", "value": "5.0", "expected": 5 },
    { "type": "Int32", "value": "1e3", "expected": 1000 },
    { "type": "Int32", "value": "-0", "expected": 0 },
    { "type": "Int32", "value": 1.5, "error": "Cannot convert 1.5 to Int32" },
    { "type": "Int32", "value": "1.5", "error": "Cannot convert \"1.5\" to Int32" },
    { "type": "Int32", "value": "5e-1", "error": "Cannot convert \"5e-1\" to Int32" },
    { "type": "Int32", "value": 2147483648, "error": "2147483648 is outside the Int32 range" },
    { "type": "Int32", "value": "2147483648", "error": "2147483648 is outside the Int32 range" },
    { "type": "Int32", "value": 1e20, "error": "100000000000000000000 is outside the Int32 range" },
    { "type": "Int32", "value": "1e400", "error": "1e400 is outside the Int32 range" },
    { "type": "Int32", "value": 1e400, "error": "The number is outside the Int32 range" },
    { "type": "Int32", "value": true, "error": "Cannot convert true to Int32" },
    { "type": "Int32", "value": "true", "error": "Cannot convert \"true\" to Int32" },
    { "type": "Int32", "value": [5], "error": "Cannot convert [5] to Int32", "note": "Node's String([5]) is \"5\", so this was written as 5." },
    { "type": "Int32", "value": ["5"], "error": "Cannot convert [\"5\"] to Int32" },
    { "type": "Int32", "value": "0x10", "error": "Cannot convert \"0x10\" to Int32" },
    { "type": "Int32", "value": "+5", "error": "Cannot convert \"+5\" to Int32", "note": "Both runtimes accepted this; JSON's grammar has no leading +." },
    { "type": "Int32", "value": "007", "error": "Cannot convert \"007\" to Int32", "note": "Both runtimes accepted this; JSON's grammar has no leading zeros." },
    { "type": "Int32", "value": "1_000", "error": "Cannot convert \"1_000\" to Int32" },
    { "type": "Int32", "value": "١٢", "error": "Cannot convert \"١٢\" to Int32", "note": "Python's \\d matched these." },
    { "type": "Int32", "value": "", "error": "Cannot convert \"\" to Int32" },
    { "type": "Int32", "value": null, "error": "Cannot write null as Int32" },
    { "type": "UInt32", "value": -1, "error": "-1 is outside the UInt32 range" },
    { "type": "Byte", "value": 300.0, "error": "300 is outside the Byte range" },
    { "type": "SByte", "value": "-128", "expected": -128 },

    { "type": "Int64", "value": "9223372036854775807", "expected": "9223372036854775807" },
    { "type": "Int64", "value": "-9223372036854775808", "expected": "-9223372036854775808" },
    { "type": "Int64", "value": 9007199254740991, "expected": "9007199254740991" },
    { "type": "Int64", "value": -5, "expected": "-5" },
    { "type": "Int64", "value": 9007199254740993, "error": "A JSON number beyond ±9007199254740991 has lost precision before it arrives; send Int64 values this large as decimal strings", "note": "JavaScript has already rounded this to ...992; Python has it exactly. Neither guesses." },
    { "type": "UInt64", "value": "18446744073709551615", "expected": "18446744073709551615" },
    { "type": "UInt64", "value": "18446744073709551616", "error": "18446744073709551616 is outside the UInt64 range" },
    { "type": "UInt64", "value": "1.8446744073709551615e19", "expected": "18446744073709551615", "note": "Exact: evaluated on the digits, not through a double." },

    { "type": "Boolean", "value": true, "expected": true },
    { "type": "Boolean", "value": false, "expected": false },
    { "type": "Boolean", "value": "true", "expected": true },
    { "type": "Boolean", "value": "TRUE", "expected": true },
    { "type": "Boolean", "value": " yes ", "expected": true },
    { "type": "Boolean", "value": "off", "expected": false },
    { "type": "Boolean", "value": "1", "expected": true },
    { "type": "Boolean", "value": "0", "expected": false },
    { "type": "Boolean", "value": 1, "expected": true },
    { "type": "Boolean", "value": 0, "expected": false },
    { "type": "Boolean", "value": 1.0, "expected": true, "note": "Python's str(1.0) is \"1.0\", which it refused." },
    { "type": "Boolean", "value": 2, "error": "Cannot convert 2 to Boolean" },
    { "type": "Boolean", "value": 0.5, "error": "Cannot convert 0.5 to Boolean" },
    { "type": "Boolean", "value": "2", "error": "Cannot convert \"2\" to Boolean" },
    { "type": "Boolean", "value": "", "error": "Cannot convert \"\" to Boolean" },
    { "type": "Boolean", "value": "definitely", "error": "Cannot convert \"definitely\" to Boolean" },
    { "type": "Boolean", "value": [true], "error": "Cannot convert [true] to Boolean" },
    { "type": "Boolean", "value": null, "error": "Cannot write null as Boolean" },

    { "type": "String", "value": "AUTO", "expected": "AUTO" },
    { "type": "String", "value": "", "expected": "" },
    { "type": "String", "value": "  padded ", "expected": "  padded ", "note": "A string is written as given, never trimmed." },
    { "type": "String", "value": 42, "error": "String values must be a JSON string", "note": "Unambiguous, but 1.0 and 1e20 are not: Node wrote \"1\" and \"100000000000000000000\", Python \"1.0\" and \"1e+20\"." },
    { "type": "String", "value": 1.0, "error": "String values must be a JSON string" },
    { "type": "String", "value": true, "error": "String values must be a JSON string", "note": "Node wrote \"true\", Python \"True\"." },
    { "type": "String", "value": ["a"], "error": "String values must be a JSON string" },
    { "type": "String", "value": null, "error": "Cannot write null as String" },

    { "type": "DateTime", "value": "2026-09-17T10:30:00Z", "expected": "2026-09-17T10:30:00.000Z" },
    { "type": "DateTime", "value": "2026-09-17T12:30:00+02:00", "expected": "2026-09-17T10:30:00.000Z" },
    { "type": "DateTime", "value": "2026-09-17T10:30:00", "error": "Invalid date/time: \"2026-09-17T10:30:00\" has no timezone, so the instant it names depends on where it is read. Add Z for UTC or an offset such as +02:00, e.g. 2026-04-23T17:40:00Z", "note": "Node wrote the host's local time, Python UTC." },
    { "type": "DateTime", "value": "2026-02-30T00:00:00Z", "error": "Invalid date/time: \"2026-02-30T00:00:00Z\". Use ISO 8601, e.g. 2026-04-23T17:40:00Z", "note": "Node's write path wrote 2 March." },
    { "type": "DateTime", "value": 1758105000000, "error": "DateTime values must be an ISO 8601 string, e.g. 2026-04-23T17:40:00Z" },

    { "type": "Guid", "value": "72962B91-FA75-4AE6-8D28-B404DC7DAF63", "expected": "72962b91-fa75-4ae6-8d28-b404dc7daf63" },
    { "type": "Guid", "value": "00000000-0000-0000-0000-000000000000", "expected": "00000000-0000-0000-0000-000000000000", "note": "The nil Guid is a Guid; Node refused anything but RFC 4122 versions 1-5." },
    { "type": "Guid", "value": "01890a5d-ac96-774b-bcce-b302099a8057", "expected": "01890a5d-ac96-774b-bcce-b302099a8057", "note": "A version 7 UUID, which Node refused." },
    { "type": "Guid", "value": "{72962b91-fa75-4ae6-8d28-b404dc7daf63}", "error": "\"{72962b91-fa75-4ae6-8d28-b404dc7daf63}\" is not a Guid", "note": "Python's UUID() accepted braces, urn:uuid: and no hyphens." },
    { "type": "Guid", "value": "72962b91fa754ae68d28b404dc7daf63", "error": "\"72962b91fa754ae68d28b404dc7daf63\" is not a Guid" },
    { "type": "Guid", "value": "urn:uuid:72962b91-fa75-4ae6-8d28-b404dc7daf63", "error": "\"urn:uuid:72962b91-fa75-4ae6-8d28-b404dc7daf63\" is not a Guid" },
    { "type": "Guid", "value": 42, "error": "42 is not a Guid" },

    { "type": "ByteString", "value": "AP8=", "expected": "AP8=" },
    { "type": "ByteString", "value": "", "expected": "" },
    { "type": "ByteString", "value": "not base64!", "error": "ByteString values must be standard base64" },
    { "type": "ByteString", "value": "AP8", "error": "ByteString values must be standard base64" },
    { "type": "ByteString", "value": 1234, "error": "ByteString values must be standard base64", "note": "Python base64-decoded str(1234)." },

    { "type": "LocalizedText", "value": "Hello", "expected": "Hello" },
    { "type": "LocalizedText", "value": { "text": "Hi", "locale": "en" }, "error": "LocalizedText values must be a JSON string", "note": "Node passed the object to node-opcua as is; Python wrote str(dict)." },
    { "type": "LocalizedText", "value": 5, "error": "LocalizedText values must be a JSON string" },
    { "type": "QualifiedName", "value": "Name", "expected": "Name" },
    { "type": "QualifiedName", "value": { "name": "x" }, "error": "QualifiedName values must be a JSON string" },

    { "type": "Int16", "array": true, "value": "[\"1\", \"2\"]", "expected": [1, 2] },
    { "type": "Int16", "array": true, "value": [1, 2], "expected": [1, 2] },
    { "type": "Int16", "array": true, "value": 5, "error": "Int16 array values must be a JSON array" },
    { "type": "Int16", "array": true, "value": "[1, 2", "error": "Int16 array values must be a JSON array" },
    { "type": "Int16", "array": true, "value": [1, "x"], "error": "Cannot convert \"x\" to Int16" },
    { "type": "Double", "array": true, "value": "[NaN]", "error": "Double array values must be a JSON array", "note": "Python's json.loads reads NaN; JSON.parse does not." },
    { "type": "Double", "array": true, "value": "[1e400]", "error": "The number is outside the Double range" },
    { "type": "Int64", "array": true, "value": "[9007199254740993]", "error": "A JSON number beyond ±9007199254740991 has lost precision before it arrives; send Int64 values this large as decimal strings" }
  ],
  "numbers": [
    { "value": 42, "expected": 42 },
    { "value": 42.5, "expected": 42.5 },
    { "value": "42.5", "expected": 42.5 },
    { "value": "  42.5  ", "expected": 42.5 },
    { "value": "-1e3", "expected": -1000 },
    { "value": "", "expected": null },
    { "value": "warm", "expected": null },
    { "value": "0x10", "expected": null, "note": "Node's Number() read 16." },
    { "value": "1_000", "expected": null, "note": "Python's float() read 1000." },
    { "value": "inf", "expected": null },
    { "value": "nan", "expected": null, "note": "NaN compared false against every bound, so it passed all of them on Python." },
    { "value": "Infinity", "expected": null },
    { "value": "1e400", "expected": null },
    { "value": "+5", "expected": null },
    { "value": "١٢", "expected": null },
    { "value": true, "expected": null },
    { "value": false, "expected": null },
    { "value": null, "expected": null },
    { "value": [1], "expected": null }
  ]
}
